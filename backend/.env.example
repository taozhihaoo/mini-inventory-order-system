# ShopStock backend environment variables (copy to .env if needed).
# All values below are the defaults — nothing here is a secret.

# SQLAlchemy database URL (SQLite by default)
DATABASE_URL=sqlite:///./shopstock.db

# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# dev | test  ("test" skips schema auto-creation)
APP_ENV=dev
